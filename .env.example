# Copy to .env. With nothing set, OFFSET runs on a simulated PayPal and rule-based agents.

# Claude makes the agents' decisions. Without it, fixed rules stand in and the interface says so.
ANTHROPIC_API_KEY=

# One PayPal SANDBOX REST app per demo business (developer.paypal.com > Apps & Credentials).
# Each app needs Invoicing and Payouts turned on. All six must be set, or OFFSET stays simulated.
PAYPAL_LUMEN_CLIENT_ID=
PAYPAL_LUMEN_SECRET=
PAYPAL_LUMEN_EMAIL=
PAYPAL_HARBOR_CLIENT_ID=
PAYPAL_HARBOR_SECRET=
PAYPAL_HARBOR_EMAIL=
PAYPAL_KITE_CLIENT_ID=
PAYPAL_KITE_SECRET=
PAYPAL_KITE_EMAIL=
PAYPAL_SWIFT_CLIENT_ID=
PAYPAL_SWIFT_SECRET=
PAYPAL_SWIFT_EMAIL=
PAYPAL_BOXWELL_CLIENT_ID=
PAYPAL_BOXWELL_SECRET=
PAYPAL_BOXWELL_EMAIL=
PAYPAL_PIXEL_CLIENT_ID=
PAYPAL_PIXEL_SECRET=
PAYPAL_PIXEL_EMAIL=

# The public https address of this server, so PayPal can deliver webhooks. Leave empty locally:
# payments are then confirmed by polling PayPal. On Render this is picked up automatically.
PUBLIC_URL=
